# Apache / Hostinger / cPanel SPA fallback for ERPOVO.
# Sends every non-file, non-directory request to index.html so client-side
# routes (/login, /signup, /companies, /app, /app/*) resolve on direct URL
# entry, hard refresh, and deep links.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite real files (assets, sw.js, manifest, icons, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html (SPA fallback)
  RewriteRule ^ index.html [L]
</IfModule>

# Never cache the SPA shell or the service worker — they must always
# revalidate so new builds take effect immediately.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|erpovo-sw-cleanup\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed Vite assets are immutable.
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# MIME safety
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>
