# Copy this file to `.env.e2e` and fill in real values for local Playwright runs.
# `.env.e2e` is git-ignored. Never commit real secrets.
#
# In CI, set the same names under repo Settings → Secrets and variables → Actions.

# --- Application (used by the app under test) ---------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- E2E target + credentials -------------------------------------------------
# URL of a running ERPOVO instance — local dev, preview, or staging.
E2E_BASE_URL=http://localhost:8080

# Owner / admin account of the seeded test company (full Recycle Bin access).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Normal member account WITHOUT the recycle_bin permission.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# --- Admin client used by seeders, audit assertions, and cleanup --------------
# Same project as VITE_SUPABASE_URL above. Service-role key bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# UUID of the company that owns the seeded test data.
E2E_COMPANY_ID=

# --- Optional ----------------------------------------------------------------
# Re-login both roles even if e2e/.auth/*.json already exists.
E2E_FORCE_LOGIN=0
# Skip post-run cleanup (useful while debugging).
E2E_SKIP_TEARDOWN=0
